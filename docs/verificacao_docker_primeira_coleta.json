    {
      "etapa": "04-inspecao",
      "comando": [
        "docker",
        "compose",
        "run",
        "--rm",
        "--no-deps",
        "-T",
        "--entrypoint",
        "python",
        "pipeline",
        "-c",
        "\nimport importlib.util, json, os, shutil, sqlite3\nfrom pathlib import Path\nfrom urllib.parse import urlsplit\nimport re\nassert os.getuid() == 10001\nassert not any(importlib.util.find_spec(n) for n in ('pytest', 'ruff'))\nassert shutil.which('uv') is None\nassert all(not Path('/app', n).exists() for n in ('.git', 'tests', 'docs', 'reports'))\nassert not list(Path('/app/data').iterdir()) == []\nassert os.environ['MLFLOW_DISABLE_TELEMETRY'] == 'true'\ntry:\n    Path('/app/escrita_proibida').write_text('teste')\nexcept OSError:\n    pass\nelse:\n    raise AssertionError('Codigo deve permanecer somente leitura.')\ndb = sqlite3.connect('file:/app/artifacts/mlflow.db?mode=ro', uri=True)\nsumarios = []\nfor path in sorted(Path('/app/artifacts').glob('*/resumo.json')):\n    s = json.loads(path.read_text())\n    assert s['status'] == 'sucesso'\n    assert s['dataset']['rows'] == 30000\n    assert s['contracts']['status'] == 'blocked_as_expected'\n    assert s['model']['roundtrip_predictions_equal']\n    assert set(s['scenarios']) == {'control', 'covariate', 'concept', 'combined'}\n    assert s['tracking']['status'] == 'completed'\n    pai = s['tracking']['run_id']\n    assert db.execute('select status from runs where run_uuid=?', (pai,)).fetchone()[0] == 'FINISHED'\n    filhos = db.execute(\"select r.run_uuid,r.status from runs r join tags t on r.run_uuid=t.run_uuid where t.key='mlflow.parentRunId' and t.value=?\", (pai,)).fetchall()\n    assert len(filhos) == 4 and all(f[1] == 'FINISHED' for f in filhos)\n    cenarios = {}\n    for nome, c in s['scenarios'].items():\n        assert c['rows'] == 2500\n        assert (path.parent / nome / c['evidently_html']).is_file()\n        assert (path.parent / nome / 'evidently.json').is_file()\n        esperados = [] if nome in ('control', 'concept') else ['limit_bal', 'pay_0']\n        assert sorted(c['drift']['summary']['drifted_features']) == sorted(esperados)\n        cenarios[nome] = {'linhas': c['rows'], 'metricas': c['performance'], 'drift': esperados}\n    html = (path.parent / 'index.html').read_text()\n    for link in re.findall(r'href=[\\\"\\']([^\\\"\\']+)[\\\"\\']', html):\n        if not urlsplit(link).scheme and not link.startswith('#'):\n            assert (path.parent / urlsplit(link).path).is_file(), link\n    sumarios.append({'execucao': s['execution_id'], 'status': s['status'], 'duracao_segundos': s['duration_seconds'], 'eventos': len(s['events']), 'alertas': len(s['alerts']), 'cenarios': cenarios, 'mlflow_pai': pai, 'mlflow_filhos': filhos})\nassert len(sumarios) == 2\nassert sumarios[0]['cenarios'] == sumarios[1]['cenarios']\nprint(json.dumps({'uid': os.getuid(), 'sem_dependencias_dev': True, 'codigo_somente_leitura': True, 'metricas_repetidas_identicas': True, 'sumarios': sumarios}))\n"
      ],
