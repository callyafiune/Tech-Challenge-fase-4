# Variável opcional: o padrão já usa SQLite local e não exige credenciais.
# Defina na sessão do terminal; o programa não carrega arquivos .env automaticamente.
# MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db

# Impede telemetria da biblioteca; não contém segredos.
MLFLOW_DISABLE_TELEMETRY=true
MLFLOW_DISABLE_AGENT_HINT=1
